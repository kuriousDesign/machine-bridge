
# Local broker URL for same-machine or LAN access. Supported schemes include mqtt://, mqtts://, ws://, and wss://.
#MQTT_LOCAL_BROKER_URL=wss://127.0.0.1:9002/mqtt


UID=1000
GID=1000

OPCUA_PORT=4840

# OPC UA server host or IP. Use a resolvable hostname like apollo-00225 or an IP like 10.70.70.50.
OPCUA_SERVER_IP_ADDRESS=127.0.0.1

# Exact CODESYS controller/application name used in the OPC UA node path.
OPCUA_CONTROLLER_NAME=CODESYS Control for Linux SL

# Select where the bridge should resolve @kuriousdesign/machine-sdk from when syncing dependencies.
# Valid values: local, npm.
MACHINE_SDK_SOURCE=local

# Local workspace path used when MACHINE_SDK_SOURCE=local.
MACHINE_SDK_LOCAL_PATH=file:../machine-sdk

# Published npm version/range used when MACHINE_SDK_SOURCE=npm.
MACHINE_SDK_NPM_VERSION=^1.0.112

# Enable only if you need the legacy stale-value republish loop for a PLC that does not emit reliable change events.
# Valid values: true or false.
ENABLE_STALE_POLLING_REPUBLISH=false

# Cloud broker websocket URL. Use wss://host:port/path for cloud/browser-style endpoints.
MQTT_CLOUD_BROKER_URL=wss://9c4d3c046b704d16a1d64328cc4e4604.s1.eu.hivemq.cloud:8884/mqtt

# Local broker URL for same-machine or LAN access. Supported schemes include mqtt://, mqtts://, ws://, and wss://.
MQTT_LOCAL_BROKER_URL=mqtt://127.0.0.1:1883

# Remote broker URL for VPN or remote-machine access. Supported schemes include mqtt://, mqtts://, ws://, and wss://.
MQTT_REMOTE_BROKER_URL=wss://apollo-00251/mqtt

# Select which MQTT broker URL the bridge should use.
# Valid values: local, remote, cloud.
MQTT_BROKER_TYPE=local

# Machine namespace used for MQTT topics before OPC UA bootstrap completes.
# Example result: bridge_00251/status and machine_00251/heartbeatplc.
MQTT_MACHINE_ID=00251

# MQTT credentials for the selected broker.
MQTT_BROKER_USERNAME=admin
MQTT_BROKER_PASSWORD=Admin1234

# When true, the bridge will not try to take OPC UA control during startup flows.
# Valid values: true or false.
IGNORE_TAKE_CONTROL=true