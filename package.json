{
  "name": "machine-bridge-server",
  "version": "2.0.1",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "deps:sync-sdk": "node scripts/sync-sdk-dependency.js",
    "deps:install": "npm run deps:sync-sdk && npm install",
    "sdk:use-local": "node scripts/sync-sdk-dependency.js --source=local",
    "sdk:use-npm": "node scripts/sync-sdk-dependency.js --source=npm",
    "build": "rm -rf dist && tsc",
    "start": "node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "generate-cert": "ts-node src/type-generator/generate-cert.ts",
    "generate-types": "npm run type-generator --",
    "copy-types-ui": "npm run copy-generated-types-to-ui --",
    "copy-generated-types-to-ui": "node scripts/copy-generated-types-to-ui.js",
    "type-generator": "ts-node src/type-generator/generate-machine-types.ts",
    "get-types": "npm run type-generator",
    "generate-machine-types": "npm run type-generator",
    "test-mqtt-connection": "ts-node test/test-mqtt-connection.ts",
    "test-read-enum-comments": "ts-node test/test-read-enum-comments.ts",
    "test-read-enum-comments-from-variable": "ts-node test/test-read-enum-comments-from-variable.ts",
    "test-read-enum-deviceids": "ts-node test/test-read-enum-deviceids.ts",
    "test-read-struct-diagnostic": "ts-node test/test-read-struct-diagnostic.ts",
    "test-muted-children-array": "ts-node test/test-muted-children-array.ts",
    "test-generate-machine-devices-types": "npm run type-generator",
    "dev-poller": "nodemon --exec ts-node src/index-poller.ts",
    "dev-subscriber": "nodemon --exec ts-node src/index-subscriber.ts",
    "dev-hmi": "nodemon --exec ts-node src/index-hmi.ts",
    "dev-old": "nodemon --exec ts-node src/index_deprecated.ts"
  },
  "dependencies": {
    "@kuriousdesign/machine-sdk": "file:../machine-sdk",
    "@types/ws": "^8.18.1",
    "aedes": "^0.51.3",
    "config": "^4.1.1",
    "dotenv": "^17.2.3",
    "mqtt": "^5.14.1",
    "node-opcua": "^2.156.0",
    "websocket-stream": "^5.5.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
